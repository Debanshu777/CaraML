diff --git a/common/scoped-model-context.h b/common/scoped-model-context.h
new file mode 100644
index 000000000..2fd316d00
--- /dev/null
+++ b/common/scoped-model-context.h
@@ -0,0 +1,58 @@
+#pragma once
+
+namespace caraml {
+
+template <typename Model, typename Context>
+class ScopedModelContext {
+public:
+    using ModelDeleter = void (*)(Model *);
+    using ContextDeleter = void (*)(Context *);
+
+    ScopedModelContext(ModelDeleter free_model, ContextDeleter free_context)
+        : free_model_(free_model), free_context_(free_context) {}
+
+    ~ScopedModelContext() {
+        reset_context(nullptr);
+        reset_model(nullptr);
+    }
+
+    ScopedModelContext(const ScopedModelContext &) = delete;
+    ScopedModelContext &operator=(const ScopedModelContext &) = delete;
+
+    void reset_model(Model *model) {
+        if (model_) free_model_(model_);
+        model_ = model;
+    }
+
+    void reset_context(Context *context) {
+        if (context_) free_context_(context_);
+        context_ = context;
+    }
+
+private:
+    Model *model_ = nullptr;
+    Context *context_ = nullptr;
+    ModelDeleter free_model_;
+    ContextDeleter free_context_;
+};
+
+template <typename Callback, typename UserData>
+class ScopedRestore {
+public:
+    using Restore = void (*)(Callback, UserData);
+
+    ScopedRestore(Callback callback, UserData user_data, Restore restore)
+        : callback_(callback), user_data_(user_data), restore_(restore) {}
+
+    ~ScopedRestore() { restore_(callback_, user_data_); }
+
+    ScopedRestore(const ScopedRestore &) = delete;
+    ScopedRestore &operator=(const ScopedRestore &) = delete;
+
+private:
+    Callback callback_;
+    UserData user_data_;
+    Restore restore_;
+};
+
+} // namespace caraml
