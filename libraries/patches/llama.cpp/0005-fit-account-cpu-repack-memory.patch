diff --git a/common/fit-memory-pool.h b/common/fit-memory-pool.h
new file mode 100644
--- /dev/null
+++ b/common/fit-memory-pool.h
@@ -0,0 +1,24 @@
+#pragma once
+
+#include "ggml-backend.h"
+
+#include <vector>
+
+// is_host also requires standard tensor layout. CPU_REPACK uses host memory
+// with a different layout, so its CPU device must determine memory ownership.
+// Return the host slot (devices.size()), a device slot, or -1 if unaccountable.
+inline int common_fit_memory_pool_index(
+        ggml_backend_buffer_type_t buft,
+        const std::vector<ggml_backend_dev_t> & devices) {
+    if (!buft) return -1;
+    const ggml_backend_dev_t dev = ggml_backend_buft_get_device(buft);
+    if (ggml_backend_buft_is_host(buft) ||
+        (dev && ggml_backend_dev_type(dev) == GGML_BACKEND_DEVICE_TYPE_CPU)) {
+        return static_cast<int>(devices.size());
+    }
+    if (!dev) return -1;
+    for (size_t i = 0; i < devices.size(); ++i) {
+        if (dev == devices[i]) return static_cast<int>(i);
+    }
+    return -1;
+}
