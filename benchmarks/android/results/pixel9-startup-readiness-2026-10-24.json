  "scope": "Fresh process, initialized empty catalog, initial persisted theme/inventory and recovery complete, rendered app shell. Excludes model readiness and inference.",
  "analysis": {
    "processor": "Perfetto v58.2-add693d8b",
    "windows": "android_startup_time_to_display TTID and TTFD bounds; inclusive phase durations overlap",
